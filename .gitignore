# =============================================================================
# StockPilot Root .gitignore
# =============================================================================

# --- Environment & Secrets (NEVER COMMIT) ---
.env
.env.*
!.env.example
*.env
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
credentials.json

# --- Python & Django ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual Environments
venv/
.venv/
env/
**/venv/
**/.venv/

# Django Database & Media
*.log
*.pot
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# --- Node.js & Frontend ---
node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/
**/dist/
**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# --- IDEs & Editors ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Operating System ---
.DS_Store
Thumbs.db

# Base URL of the StockPilot Django backend API (must point to /api endpoint)
# Local development default:
VITE_API_URL=http://127.0.0.1:8000/api

# Production example (Render Web Service):
# VITE_API_URL=https://stockpilot-backend.onrender.com/api
